# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
# Values come from the X developer console (console.x.com) under your app's
# "Keys & Tokens" tab, after setting up OAuth 2.0 user authentication.

# OAuth 2.0 Client ID. Required.
X_CLIENT_ID=

# Only set this if you registered a confidential client (Web App / Automated App
# or Bot). A Native App uses PKCE and has no secret — leave this blank.
X_CLIENT_SECRET=

# Optional. Where post history, mentions and metrics are stored.
# Defaults to ~/.claude-x
# CLAUDE_X_DATA_DIR=
